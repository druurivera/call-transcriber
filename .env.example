# Whisper
ENGINE=auto                  # auto | mlx | faster
MODEL=                       # blank uses large-v3-turbo
LANGUAGE=en                  # en | tl | auto  (set by the --compare benchmark)

# Vault
# Folder where notes get written. If blank, defaults to ~/vault
# (Mac/Linux) or %USERPROFILE%\vault (Windows). Point it at your
# Obsidian vault or any folder with "10 - Projects" / "00 - Inbox".
VAULT=

# Analysis pass
OPENROUTER_API_KEY=
ANALYSIS_MODEL=deepseek/deepseek-v4-pro
